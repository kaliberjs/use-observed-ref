{
  "include": [
    "./index.js",
    "./src/**/*",
    "./scripts/**/*"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "allowUmdGlobalAccess": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true
  }
}
